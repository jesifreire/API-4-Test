{
  "name": "api-login",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "mocha --exit --recursive",
    "perf": "k6 run test/perf/login.k6.js",
    "perf:html": "powershell -NoProfile -Command \"$env:K6_WEB_DASHBOARD='true'; $env:K6_WEB_DASHBOARD_EXPORT='k6-html-report.html'; k6 run test/perf/login.k6.js\"",
    "perf:html:long": "powershell -NoProfile -Command \"$env:K6_WEB_DASHBOARD='true'; $env:K6_WEB_DASHBOARD_EXPORT='k6-html-report.html'; k6 run --duration 30s test/perf/login.k6.js\""
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "nodemon": "^2.0.22",
    "sinon": "^15.0.0",
    "supertest": "^6.3.3"
  }
}
